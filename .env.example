# Copy this file to ".env" and change the values:   cp .env.example .env
# The real .env file must NEVER be committed or shared.
# Tip: use only letters and digits in POSTGRES_PASSWORD, because it is placed
# inside the DATABASE_URL (special characters like @ or / would break it).

# --- PostgreSQL (used by the db container and to build DATABASE_URL) ---
POSTGRES_USER=uniuser
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=university

# --- Flask application ---
# Long random text used to sign the login session cookie.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_value

# --- Administrator account ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
